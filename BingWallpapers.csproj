<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\wallpapers.ico</ApplicationIcon>
    <AssemblyTitle>Bing Wallpapers</AssemblyTitle>
    <Product>Bing Wallpapers</Product>
    <Version>1.1.0</Version>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
    <AutomaticUseReferenceAssemblyPackages>false</AutomaticUseReferenceAssemblyPackages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AntdUI" Version="2.4.19" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
</Project>
