<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\wallpapers.ico</ApplicationIcon>
    <AssemblyTitle>Dayframe</AssemblyTitle>
    <Product>Dayframe</Product>
    <Version>2.1.8</Version>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutomaticUseReferenceAssemblyPackages>false</AutomaticUseReferenceAssemblyPackages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AntdUI" Version="2.4.19" GeneratePathProperty="true" ExcludeAssets="runtime" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <EmbeddedResource Include="$(PkgAntdUI)\lib\net46\AntdUI.dll" LogicalName="BingWallpapers.Dependencies.AntdUI.dll" />
    <EmbeddedResource Include="Assets\Dayframe.svg" LogicalName="BingWallpapers.Assets.Dayframe.svg" />
    <EmbeddedResource Include="Assets\Fonts\Inter*.ttf;Assets\Fonts\JetBrainsMono.ttf"
                      LogicalName="BingWallpapers.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Licenses\*.txt" Exclude="Licenses\InstrumentSerif-OFL.txt"
                      LogicalName="BingWallpapers.Licenses.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
